{
  "name": "educarparatransformar-sistemagestion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "server": "node --env-file-if-exists=.env backend/server.js",
    "start": "node backend/server.js",
    "seed": "node --env-file-if-exists=.env backend/seed.js",
    "crear-admin": "node --env-file-if-exists=.env backend/crear-admin.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production') { try { (await import('child_process')).execSync('npx --no-install husky', { stdio: 'inherit' }); } catch {} }\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "cy:open": "cypress open",
    "cy:run": "cypress run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^9.2.1",
    "cypress": "^16.2.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "vitest": "^5.0.5"
  }
}
