# Copiá este archivo como .env para cambiar la configuración local.
# Todas las variables son opcionales salvo DATABASE_URL.

# Cadena de conexión a PostgreSQL
# Formato: postgres://usuario:contraseña@host:5432/nombre_base
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gestion

# Puerto del backend (Express)
PORT=3002

# Puerto del frontend (Vite) y URL del backend a la que apunta su proxy de /api
FRONTEND_PORT=5173
API_URL=http://localhost:3002

# Clave para firmar los tokens de sesión (JWT). En producción usar una clave larga y secreta.
JWT_SECRET=clave-de-desarrollo-cambiar-en-produccion
# Duración de la sesión
JWT_DURACION=8h
