# Copiá este archivo como .env para cambiar la configuración local.
# Todas las variables son opcionales; estos son los valores por defecto.

# Puerto del backend (Express)
PORT=3002

# Archivo de la base SQLite (ruta relativa a la carpeta del proyecto)
DB_FILE=backend/gestion.sqlite

# Puerto del frontend (Vite) y URL del backend a la que apunta su proxy de /api
FRONTEND_PORT=5173
API_URL=http://localhost:3002
